644\u0642\u0648\u0627\u0646\u064a\u0646 \u0648\u0627\u0644\u0644\u0648\u0627\u0626\u062d \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629. \u0641\u064a \u062d\u0627\u0644 \u0639\u062f\u0645 \u0645\u0648\u0627\u0641\u0642\u062a\u0643\u060c \u064a\u0631\u062c\u0649 \u0639\u062f\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0648\u0642\u0639 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0627\u062a.<\/p>\n\n  <h2>2. \u062d\u0642\u0648\u0642 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0627\u0644\u0641\u0643\u0631\u064a\u0629<\/h2>\n  <p>\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u062d\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0642\u0639\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0646\u0635\u0648\u0635\u060c \u0627\u0644\u0635\u0648\u0631\u060c \u0627\u0644\u062a\u0635\u0627\u0645\u064a\u0645\u060c \u0627\u0644\u0634\u0639\u0627\u0631\u0627\u062a\u060c \u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0641\u064a\u062f\u064a\u0648\u060c \u0648\u0623\u064a \u0645\u0648\u0627\u062f \u0623\u062e\u0631\u0649\u060c \u0647\u064a \u0645\u0645\u0644\u0648\u0643\u0629 \u0644\u0645\u0624\u0633\u0633\u0629 \u0623\u062d\u0644\u0627\u0645 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0648\u0645\u062d\u0645\u064a\u0651\u0629 \u0628\u0645\u0648\u062c\u0628 \u0642\u0648\u0627\u0646\u064a\u0646 \u062d\u0642\u0648\u0642 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0627\u0644\u0641\u0643\u0631\u064a\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0648\u0627\u0644\u062f\u0648\u0644\u064a\u0629. \u0644\u0627 \u064a\u062c\u0648\u0632 \u0646\u0633\u062e \u0623\u0648 \u0625\u0639\u0627\u062f\u0629 \u0646\u0634\u0631 \u0623\u0648 \u062a\u0648\u0632\u064a\u0639 \u0623\u064a \u0645\u062d\u062a\u0648\u0649 \u062f\u0648\u0646 \u0625\u0630\u0646 \u0643\u062a\u0627\u0628\u064a \u0645\u0633\u0628\u0642.<\/p>\n\n  <h2>3. \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0648\u0642\u0639<\/h2>\n  <p>\u064a\u064f\u0633\u0645\u062d \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0648\u0642\u0639 \u0641\u0642\u0637 \u0644\u0644\u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0648\u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0623\u0648 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u0629. \u064a\u0645\u0646\u0639 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0648\u0642\u0639 \u0641\u064a \u0623\u064a \u0646\u0634\u0627\u0637 \u063a\u064a\u0631 \u0642\u0627\u0646\u0648\u0646\u064a \u0623\u0648 \u0645\u0636\u0631 \u0628\u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0623\u0648 \u0628\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0622\u062e\u0631\u064a\u0646.<\/p>\n\n  <h2>4. \u0634\u0631\u0648\u0637 \u0627\u0644\u062e\u062f\u0645\u0627\u062a<\/h2>\n  <p>\u062a\u062d\u062a\u0641\u0638 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0628\u062d\u0642\u0647\u0627 \u0641\u064a \u0642\u0628\u0648\u0644 \u0623\u0648 \u0631\u0641\u0636 \u0623\u064a \u0637\u0644\u0628 \u062e\u062f\u0645\u0629 \u0648\u0641\u0642\u064b\u0627 \u0644\u062a\u0642\u062f\u064a\u0631\u0647\u0627 \u0627\u0644\u062e\u0627\u0635. \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062e\u062f\u0645\u0629 (\u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a\u060c \u0627\u0644\u0623\u0633\u0639\u0627\u0631\u060c \u0645\u062f\u0629 \u0627\u0644\u062a\u0646\u0641\u064a\u0630) \u0641\u064a \u0627\u0644\u0639\u0642\u0648\u062f \u0623\u0648 \u0627\u0644\u0627\u062a\u0641\u0627\u0642\u064a\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639\u0629 \u0645\u0639 \u0627\u0644\u0639\u0645\u064a\u0644. \u062c\u0645\u064a\u0639 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0645\u063a\u0637\u0627\u0629 \u0628\u0633\u064a\u0627\u0633\u0627\u062a \u0627\u0644\u0636\u0645\u0627\u0646 \u0648\u0627\u0644\u0635\u064a\u0627\u0646\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u0645\u0646 \u0642\u0628\u0644 \u0627\u0644\u0645\u0624\u0633\u0633\u0629.<\/p>\n\n  <h2>5. \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a<\/h2>\n  <p>\u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0623\u0648 \u062a\u0642\u062f\u064a\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0639\u0628\u0631 \u0627\u0644\u0645\u0648\u0642\u0639\u060c \u0641\u0625\u0646\u0643 \u062a\u0644\u062a\u0632\u0645 \u0628\u062a\u0642\u062f\u064a\u0645 \u0628\u064a\u0627\u0646\u0627\u062a \u062f\u0642\u064a\u0642\u0629 \u0648\u0643\u0627\u0645\u0644\u0629\u060c \u0648\u062a\u062a\u062d\u0645\u0644 \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u062a\u062d\u062f\u064a\u062b\u0647\u0627 \u0628\u0634\u0643\u0644 \u0645\u0633\u062a\u0645\u0631. \u0643\u0645\u0627 \u062a\u062a\u062d\u0645\u0644 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 \u0639\u0646 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0633\u0631\u064a\u0629 \u062d\u0633\u0627\u0628\u0643 \u0648\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631.<\/p>\n\n  <h2>6. \u062d\u062f\u0648\u062f \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629<\/h2>\n  <p>\u0644\u0627 \u062a\u062a\u062d\u0645\u0644 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0623\u064a \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0646 \u0627\u0644\u0623\u0636\u0631\u0627\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0627\u0644\u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0648 \u0639\u062f\u0645 \u0627\u0644\u0642\u062f\u0631\u0629 \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0648\u0642\u0639 \u0623\u0648 \u0627\u0644\u062e\u062f\u0645\u0627\u062a. \u0644\u0627 \u062a\u0636\u0645\u0646 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u062e\u0644\u0648 \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0646 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0623\u0648 \u0627\u0644\u0627\u0646\u0642\u0637\u0627\u0639\u0627\u062a \u0627\u0644\u0645\u0624\u0642\u062a\u0629.<\/p>\n\n  <h2>7. \u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629<\/h2>\n  <p>\u0642\u062f \u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0645\u0648\u0642\u0639 \u0639\u0644\u0649 \u0631\u0648\u0627\u0628\u0637 \u0644\u0645\u0648\u0627\u0642\u0639 \u062e\u0627\u0631\u062c\u064a\u0629. \u0644\u0627 \u062a\u062a\u062d\u0645\u0644 \u0645\u0624\u0633\u0633\u0629 \u0623\u062d\u0644\u0627\u0645 \u0627\u0644\u062c\u0632\u064a\u0631\u0629 \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0645\u062d\u062a\u0648\u0649 \u0623\u0648 \u0633\u064a\u0627\u0633\u0627\u062a \u0647\u0630\u0647 \u0627\u0644\u0645\u0648\u0627\u0642\u0639\u060c \u0648\u064a\u064f\u0646\u0635\u062d \u0628\u0645\u0631\u0627\u062c\u0639\u0629 \u0633\u064a\u0627\u0633\u0627\u062a \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0648\u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u0627.<\/p>\n\n  <h2>8. \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a<\/h2>\n  <p>\u064a\u062d\u0642 \u0644\u0644\u0645\u0624\u0633\u0633\u0629 \u062a\u0639\u062f\u064a\u0644 \u0623\u0648 \u062a\u062d\u062f\u064a\u062b \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0641\u064a \u0623\u064a \u0648\u0642\u062a\u060c \u0648\u0633\u064a\u062a\u0645 \u0646\u0634\u0631 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0645\u062d\u062f\u062b\u0629 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629. \u064a\u064f\u0639\u062a\u0628\u0631 \u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u0645\u0648\u0642\u0639 \u0628\u0639\u062f \u0646\u0634\u0631 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0645\u0648\u0627\u0641\u0642\u0629\u064b \u0639\u0644\u064a\u0647\u0627.<\/p>\n\n  <h2>9. \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0648\u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0635 \u0627\u0644\u0642\u0636\u0627\u0626\u064a<\/h2>\n  <p>\u062a\u062e\u0636\u0639 \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0648\u062a\u064f\u0641\u0633\u0631 \u0648\u0641\u0642\u064b\u0627 \u0644\u0644\u0642\u0648\u0627\u0646\u064a\u0646 \u0648\u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0648\u062a\u0643\u0648\u0646 \u0645\u062d\u0627\u0643\u0645 \u0627\u0644\u0645\u0645\u0644\u0643\u0629 \u0647\u064a \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0644\u0644\u0641\u0635\u0644 \u0641\u064a \u0623\u064a \u0646\u0632\u0627\u0639 \u064a\u0646\u0634\u0623.<\/p>\n\n  <h2>10. \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627<\/h2>\n  <p>\u0644\u0644\u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a \u062d\u0648\u0644 \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0639\u0628\u0631:<\/p>\n  <ul>\n    <li><strong>\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a:<\/strong> info@jazdrm.com<\/li>\n    <l