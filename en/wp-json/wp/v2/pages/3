u0644\u0637\u0644\u0628\u0627\u062a \u0623\u0648 \u0627\u0644\u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a<\/li><\/ul><p>\u0643\u0645\u0627 \u0646\u0642\u0648\u0645 \u0628\u062c\u0645\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u063a\u064a\u0631 \u0634\u062e\u0635\u064a\u0629 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627 \u0639\u0646\u062f \u062a\u0635\u0641\u062d \u0627\u0644\u0645\u0648\u0642\u0639\u060c \u0645\u062b\u0644:<\/p><ul><li>\u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a (IP)<\/li><li>\u0646\u0648\u0639 \u0627\u0644\u0645\u062a\u0635\u0641\u062d<\/li><li>\u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0645\u062a \u0632\u064a\u0627\u0631\u062a\u0647\u0627<\/li><li>\u0645\u062f\u0629 \u0627\u0644\u062a\u0635\u0641\u062d<\/li><\/ul><h2>2. \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a<\/h2><p>\u0646\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0646 \u0623\u062c\u0644:<\/p><ul><li>\u062a\u062d\u0633\u064a\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0644\u0649 \u0627\u0644\u0645\u0648\u0642\u0639<\/li><li>\u0627\u0644\u0631\u062f \u0639\u0644\u0649 \u0627\u0644\u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062e\u062f\u0645\u0627\u062a<\/li><li>\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0648\u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u062f\u0639\u0645<\/li><li>\u0625\u0631\u0633\u0627\u0644 \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0623\u0648 \u0639\u0631\u0648\u0636 \u0639\u0646\u062f \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629<\/li><li>\u062a\u062d\u0633\u064a\u0646 \u062c\u0648\u062f\u0629 \u0648\u0623\u062f\u0627\u0621 \u0627\u0644\u0645\u0648\u0642\u0639 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a<\/li><\/ul><h2>3. \u062d\u0645\u0627\u064a\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a<\/h2><p>\u0646\u0644\u062a\u0632\u0645 \u0628\u062d\u0645\u0627\u064a\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0645\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u063a\u064a\u0631 \u0627\u0644\u0645\u0635\u0631\u0651\u062d \u0628\u0647 \u0645\u0646 \u062e\u0644\u0627\u0644:<\/p><ul><li>\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 SSL<\/li><li>\u062a\u062e\u0632\u064a\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0644\u0649 \u062e\u0648\u0627\u062f\u0645 \u0622\u0645\u0646\u0629<\/li><li>\u062a\u0642\u064a\u064a\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u0633\u0627\u0633\u0629<\/li><\/ul><h2>4. \u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a<\/h2><p>\u0644\u0627 \u0646\u0634\u0627\u0631\u0643 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0645\u0639 \u0623\u064a \u0637\u0631\u0641 \u062b\u0627\u0644\u062b\u060c \u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621:<\/p><ul><li>\u0627\u0644\u062c\u0647\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u0637\u0644\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a<\/li><li>\u0645\u0642\u062f\u0645\u064a \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0641\u0646\u064a\u064a\u0646 \u0627\u0644\u0645\u0644\u062a\u0632\u0645\u064a\u0646 \u0628\u0627\u0644\u0633\u0631\u064a\u0629<\/li><\/ul><h2>5. \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637 (Cookies)<\/h2><p>\u0646\u0633\u062a\u062e\u062f\u0645 \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637 \u0644\u062a\u062d\u0633\u064a\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u062a\u0635\u0641\u062d. \u064a\u0645\u0643\u0646\u0643 \u062a\u0639\u0637\u064a\u0644\u0647\u0627 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u0635\u0641\u062d\u060c \u0645\u0639 \u0627\u062d\u062a\u0645\u0627\u0644 \u062a\u0623\u062b\u0631 \u0628\u0639\u0636 \u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u0645\u0648\u0642\u0639.<\/p><h2>6. \u062d\u0642\u0648\u0642 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645<\/h2><p>\u064a\u062d\u0642 \u0644\u0643:<\/p><ul><li>\u0637\u0644\u0628 \u0646\u0633\u062e\u0629 \u0645\u0646 \u0628\u064a\u0627\u0646\u0627\u062a\u0643<\/li><li>\u0637\u0644\u0628 \u062a\u0639\u062f\u064a\u0644 \u0623\u0648 \u062d\u0630\u0641 \u0628\u064a\u0627\u0646\u0627\u062a\u0643<\/li><li>\u0633\u062d\u0628 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0633\u0648\u064a\u0642\u064a\u0629<\/li><\/ul><p>\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0644\u062a\u0646\u0641\u064a\u0630 \u0623\u064a \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u062d\u0642\u0648\u0642.<\/p><h2>7. \u0631\u0648\u0627\u0628\u0637 \u0644\u0645\u0648\u0627\u0642\u0639 \u062e\u0627\u0631\u062c\u064a\u0629<\/h2><p>\u0642\u062f \u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0645\u0648\u0642\u0639 \u0639\u0644\u0649 \u0631\u0648\u0627\u0628\u0637 \u062e\u0627\u0631\u062c\u064a\u0629. \u0644\u0633\u0646\u0627 \u0645\u0633\u0624\u0648\u0644\u064a\u0646 \u0639\u0646 \u0645\u0645\u0627\u0631\u0633\u0627\u062a \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0641\u064a \u062a\u0644\u0643 \u0627\u0644\u0645\u0648\u0627\u0642\u0639.<\/p><h2>8. \u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629<\/h2><p>\u0642\u062f \u0646\u0642\u0648\u0645 \u0628\u062a\u062d\u